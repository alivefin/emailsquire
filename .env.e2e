# Playwright smoke tests only (npm run test:e2e). Laravel loads this file when APP_ENV=e2e is set in
# the real environment. Every value here is a throwaway test value; the APP_KEY is 32 zero bytes,
# so secret scanners see it as a placeholder, and it protects nothing.
APP_NAME=EmailSquire
APP_ENV=e2e
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=false
APP_URL=http://localhost:8123

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33060
DB_DATABASE=emailsquire_e2e
DB_USERNAME=root
DB_PASSWORD=root
EMAILSQUIRE_GUIDE_SCHEMA=mailserver_e2e

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
SESSION_COOKIE=emailsquire_e2e

EMAILSQUIRE_HIBP=false
# Nothing listens on port 9, so live usage fails fast and shows as unavailable.
DOVEADM_URL=http://127.0.0.1:9/doveadm/v1

# Email is written to storage/logs/e2e-mail.log; the queue runs inline.
MAIL_MAILER=log
MAIL_LOG_CHANNEL=e2e-mail
QUEUE_CONNECTION=sync
# The welcome email's mail server (IMAP 993, SMTP 587) and webmail link.
EMAILSQUIRE_MAIL_HOST=mail.example.org
EMAILSQUIRE_WEBMAIL_URL=https://webmail.example.org/
# The server's addresses for the DNS checks (documentation ranges). DNS itself is the fixture
# tests/e2e/fixtures/dns.json (FakeDnsResolver): example.org is all green, example.net lacks DMARC and
# its DKIM record.
EMAILSQUIRE_SERVER_IPS=192.0.2.10,2001:db8::10
# Postfix's alias maps for the catch-all gate: a fixture main.cf naming the installer's email2email map,
# so admins and managers may set catch-all forwarding (relative to the app's base directory).
EMAILSQUIRE_POSTFIX_MAIN_CF=tests/e2e/fixtures/postfix/main.cf

# The portal's Help screen names this when the owner's domain has no manager (example.org has none).
EMAILSQUIRE_SUPPORT_CONTACT="Example Hosting support, help@example.net"

# Admins must have two-factor (the default, stated here so the e2e run never depends on it).
EMAILSQUIRE_REQUIRE_TWO_FACTOR=admins
