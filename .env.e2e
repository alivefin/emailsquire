# Playwright smoke tests only (npm run test:e2e). Laravel loads this file when APP_ENV=e2e is set in
# the real environment. Every value here is a throwaway test value; the APP_KEY was generated for
# this file and protects nothing.
APP_NAME=EmailSquire
APP_ENV=e2e
APP_KEY=base64:2jmxu0ekFebevJU8xSjYmG1CfXozP58VPMbPAGAS6Cw=
APP_DEBUG=false
APP_URL=http://localhost:8123

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33060
DB_DATABASE=emailsquire_e2e
DB_USERNAME=root
DB_PASSWORD=root
EMAILSQUIRE_GUIDE_SCHEMA=mailserver_e2e

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
SESSION_COOKIE=emailsquire_e2e

EMAILSQUIRE_HIBP=false
# Nothing listens on port 9, so live usage fails fast and shows as unavailable.
DOVEADM_URL=http://127.0.0.1:9/doveadm/v1

# Email is written to storage/logs/e2e-mail.log; the queue runs inline.
MAIL_MAILER=log
MAIL_LOG_CHANNEL=e2e-mail
QUEUE_CONNECTION=sync
# The welcome email's mail server (IMAP 993, SMTP 587) and webmail link.
EMAILSQUIRE_MAIL_HOST=mail.example.org
EMAILSQUIRE_WEBMAIL_URL=https://webmail.example.org/

# Admins must have two-factor (the default, stated here so the e2e run never depends on it).
EMAILSQUIRE_REQUIRE_TWO_FACTOR=admins
