APP_NAME=EmailSquire
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
DB_DATABASE=emailsquire
# DB_USERNAME=root
# DB_PASSWORD=
# Migrator connection: `migrate --database=migrator` and `emailsquire:grants` run as MariaDB root over the socket.
# DB_MIGRATOR_SOCKET=/run/mysqld/mysqld.sock
# DB_MIGRATOR_USERNAME=root
# DB_MIGRATOR_PASSWORD=

# Name of the schema the ISPmail guide created (virtual_domains, virtual_users, virtual_aliases).
EMAILSQUIRE_GUIDE_SCHEMA=mailserver
# Postfix main.cf that the doctor reads to check the map files.
# EMAILSQUIRE_POSTFIX_MAIN_CF=/etc/postfix/main.cf
# Root of the virtual mail store (owned by vmail).
# EMAILSQUIRE_MAIL_ROOT=/var/vmail
# Where deleted maildirs are archived; must be on the same device as the mail root.
# EMAILSQUIRE_TRASH_DIR=/var/vmail/.emailsquire-trash
# Directory holding rspamd DKIM keys.
# EMAILSQUIRE_DKIM_DIR=/var/lib/rspamd/dkim
# php.ini that PHP-FPM loads for the app; the doctor checks its disable_functions.
# EMAILSQUIRE_FPM_PHP_INI=/etc/emailsquire/php.ini
# Check new passwords against the Have I Been Pwned range API (k-anonymity, no password leaves the server).
EMAILSQUIRE_HIBP=true
# Who must set up two-factor authentication before using the console: admins (default) or everyone.
# off is for the test suite only; the doctor fails it in production.
# EMAILSQUIRE_REQUIRE_TWO_FACTOR=admins
# Whether a domain's managers may share it with other people; server admins always may.
# EMAILSQUIRE_MANAGERS_CAN_SHARE=false
# Dovecot doveadm HTTP API endpoint.
# DOVEADM_URL=http://127.0.0.1:8080/doveadm/v1
# Dovecot doveadm HTTP API key (doveadm_api_key in Dovecot's config).
DOVEADM_API_KEY=
# Unix socket of Dovecot's auth service that the app uses to verify mailbox passwords.
# DOVECOT_AUTH_SOCKET=/run/dovecot/emailsquire-auth

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail goes through the local Postfix: port 25 on 127.0.0.1, no auth, no TLS. The worker (emailsquire-queue.service) sends it.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=25
# EMAILSQUIRE_MAIL_FROM=emailsquire@mail.example.org
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
