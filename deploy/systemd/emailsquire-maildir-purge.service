[Unit]
Description=EmailSquire maildir helper (purge)
After=mariadb.service

[Service]
Type=oneshot
User=vmail
Group=vmail
; Add --trash-dir=… and --retention-days=… here when they differ from the app config.
; Keep the trash inside the mail root (the default). Archiving is a rename(), and systemd bind-mounts
; every ReadWritePaths= entry separately, so a trash dir listed as a second entry fails with EXDEV
; ("Invalid cross-device link") even on the same filesystem. If it must live elsewhere, replace the
; entry below with one common parent of the mail root and the trash dir.
ExecStart=/usr/bin/php /opt/emailsquire/current/helpers/maildir.php purge
ReadWritePaths=/var/vmail
RestrictAddressFamilies=AF_UNIX
; Not MemoryDenyWriteExecute: PHP's PCRE JIT needs W+X memory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
; The helper creates trash and lock files 0700/0600 itself (umask 0077); UMask matches it.
UMask=0077
RestrictSUIDSGID=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectHostname=yes
