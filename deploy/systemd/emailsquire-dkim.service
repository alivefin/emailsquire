[Unit]
Description=EmailSquire DKIM helper (run)
After=mariadb.service

[Service]
Type=oneshot
User=_rspamd
Group=_rspamd
; Add --dkim-dir=… and --selector-map=… here when they differ from the guide's paths, and list
; their directories below instead. The helper replaces the map with a rename() in the map's own
; directory, so that directory (not just the map) must be writable here and by _rspamd.
ExecStart=/usr/bin/php /opt/emailsquire/current/helpers/dkim.php run
ReadWritePaths=/var/lib/rspamd/dkim /etc/rspamd
RestrictAddressFamilies=AF_UNIX
; Not MemoryDenyWriteExecute: PHP's PCRE JIT needs W+X memory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
