[Unit]
Description=EmailSquire scheduler (artisan schedule:run)
After=mariadb.service

[Service]
Type=oneshot
User=emailsquire
ExecStart=/usr/bin/php /opt/emailsquire/current/artisan schedule:run
ReadWritePaths=/var/lib/emailsquire/storage
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
; Not MemoryDenyWriteExecute: PHP's PCRE JIT needs W+X memory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
